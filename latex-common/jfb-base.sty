% jfb-base.sty — Shared base layer: HEC colors and math macros
% Used by: jfb-paper, jfb-teaching-slides, jfb-research-slides, jfb-exercises, jfb-notes
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{jfb-base}[2026/03/13 JFB shared base — HEC colors and math macros]

% ============================================================
% 1. COLORS (HEC Montréal institutional palette)
% ============================================================
\RequirePackage{xcolor}

% Primary palette
\definecolor{HECnavy}{HTML}{002855}
\definecolor{HECgreen}{HTML}{26d07c}
\definecolor{HECcoral}{HTML}{ff585d}

% Extended palette (teaching)
\definecolor{HECtext}{HTML}{2D3748}
\definecolor{HECgray}{HTML}{94A3B8}
\definecolor{HEClightgray}{HTML}{F1F5F9}
\definecolor{HEClightblue}{HTML}{E8EDF3}

% Short aliases (research papers, backward compatibility)
\colorlet{HEC}{HECnavy}
\colorlet{HEC2}{HECgreen}
\colorlet{HEC3}{HECcoral}

% ============================================================
% 2. MATH (minimal set used everywhere)
% ============================================================
\RequirePackage{amsmath}
\RequirePackage{mathtools}
\RequirePackage{bm}

% Operators
\DeclareMathOperator*{\argmax}{arg\,max}
\DeclareMathOperator*{\argmin}{arg\,min}

% Commands
\newcommand{\partialof}[2]{\ensuremath{\frac{\partial #1}{\partial #2}}}
\newcommand{\totalof}[2]{\ensuremath{\frac{\mathrm{d}\, #1}{\mathrm{d}\, #2}}}
\newcommand{\pctchg}[1]{\ensuremath{\%\Delta #1}}
\newcommand{\smallquad}{\hspace{0.5em}}
\newcommand{\ignore}[1]{}

% ============================================================
% 3. GRAPHICS (needed for \resizeeq)
% ============================================================
\RequirePackage{graphicx}
\newcommand{\resizeeq}[2]{\resizebox{#2\hsize}{!}{$#1$}}

% ============================================================
% 4. COURSE PARAMETERIZATION
% ============================================================
% Set these in the course preamble after loading a domain package.
\def\jfb@coursename{}
\def\jfb@coursetitle{}
\def\jfb@instructor{}
\def\jfb@institution{HEC Montr\'{e}al}

\newcommand{\jfbcoursename}[1]{\def\jfb@coursename{#1}}
\newcommand{\jfbcoursetitle}[1]{\def\jfb@coursetitle{#1}}
\newcommand{\jfbinstructor}[1]{\def\jfb@instructor{#1}}
\newcommand{\jfbinstitution}[1]{\def\jfb@institution{#1}}

\endinput
